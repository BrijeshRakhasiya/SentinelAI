# Base URL of the SentinelAI backend.
# In local dev this can be left blank -- src/setupProxy.js proxies
# /api and /health to http://localhost:8000 for you.
# In production, point this at the deployed backend origin, e.g.
# https://sentinelai-backend-mtxy.onrender.com
REACT_APP_API_URL=http://localhost:8000

# Supabase project (Dashboard -> Project Settings -> API). User management
# and login run entirely through Supabase Auth from the browser.
REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co
REACT_APP_SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key
