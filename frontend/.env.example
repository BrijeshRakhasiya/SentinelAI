# Base URL of the SentinelAI backend.
# In local dev this can be left blank -- src/setupProxy.js proxies
# /auth, /api, and /health to http://localhost:8000 for you.
# In production, point this at the deployed backend origin, e.g.
# https://sentinelai-backend-mtxy.onrender.com
REACT_APP_API_URL=http://localhost:8000
