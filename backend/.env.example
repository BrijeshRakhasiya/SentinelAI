# --- Environment ---
# development | production
ENVIRONMENT=development

# --- Gemini ---
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.5-flash

# --- Auth (Supabase) ---
# User management/login is handled by Supabase Auth; get these from
# Supabase Dashboard -> Project Settings -> API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key

# --- CORS (comma-separated origins; never *) ---
CORS_ORIGINS=http://localhost:3000

# --- Demo mode: serve pre-recorded responses, never hit Gemini ---
USE_CACHE=true

# --- Database ---
# SQLite for local dev, or a Supabase Postgres "Connection pooling" URI, e.g.:
# postgresql://postgres.your-project-ref:PASSWORD@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=sqlite:///./sentinelai.db
