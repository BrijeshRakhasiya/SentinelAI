# --- Environment ---
# development | production
ENVIRONMENT=development

# --- Gemini ---
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.5-flash

# --- Auth ---
# Min 32 random chars. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me_to_a_long_random_string_min_32_chars
ADMIN_USERNAME=admin
# bcrypt hash, NOT plaintext.
# Generate: python -c "from passlib.hash import bcrypt; print(bcrypt.hash('your_password'))"
ADMIN_PASSWORD_HASH=

# --- CORS (comma-separated origins; never *) ---
CORS_ORIGINS=http://localhost:3000

# --- Demo mode: serve pre-recorded responses, never hit Gemini ---
USE_CACHE=true

# --- Database ---
DATABASE_URL=sqlite:///./sentinelai.db
